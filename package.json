{
  "name": "packing-list",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --setupFiles dotenv/config",
    "update-tests": "jest --updateSnapshot --setupFiles dotenv/config",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "migrate-db": "npm run build && node --env-file=.env dist/db/migrator.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@doist/todoist-sdk": "^15.8.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "kysely": "^0.29.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "maybe-postinstall": "cp -R node_modules/better-sqlite3/build ."
